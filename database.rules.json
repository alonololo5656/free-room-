{
  "rules": {
    ".read": false,
    ".write": false,
    "claims": {
      "$date": {
        ".read": "$date.matches(/^\\d{4}-\\d\\d-\\d\\d$/)",
        "$hour": {
          "$room": {
            ".write": "auth != null && $hour.matches(/^\\d{1,2}$/) && (data.exists() ? !newData.exists() && data.child('id').val() === auth.uid : newData.child('id').val() === auth.uid)",
            ".validate": "newData.hasChildren(['by', 'id', 'at']) && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('at').val() === now && $room.length <= 40",
            "$other": { ".validate": "$other === 'by' || $other === 'id' || $other === 'at'" }
          }
        }
      }
    },
    "online": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('at').val() === now",
        "$other": { ".validate": "$other === 'by' || $other === 'at'" }
      }
    }
  }
}
